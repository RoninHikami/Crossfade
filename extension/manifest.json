{
  "manifest_version": 3,
  "name": "Crossfade — перенос лайков",
  "short_name": "Crossfade",
  "version": "0.3.0",
  "description": "Переносит лайкнутые треки между Яндекс Музыкой, Spotify, Звуком и YouTube Music. Только добавляет лайки, ничего не удаляет.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Crossfade",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "identity", "notifications", "declarativeNetRequestWithHostAccess", "cookies"],
  "host_permissions": [
    "https://api.music.yandex.net/*",
    "https://oauth.yandex.ru/*",
    "https://oauth.yandex.com/*",
    "https://music.yandex.ru/*",
    "https://music.yandex.com/*",
    "https://music.yandex.by/*",
    "https://music.yandex.kz/*",
    "https://api.spotify.com/*",
    "https://accounts.spotify.com/*",
    "https://zvuk.com/*",
    "https://music.youtube.com/*"
  ]
}
