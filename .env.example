# Скопируйте в .env и заполните.

# Spotify: https://developer.spotify.com/dashboard → Create app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Этот же адрес нужно добавить в Redirect URIs в настройках приложения
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Яндекс Музыка: OAuth-токен (как получить — в README)
YANDEX_MUSIC_TOKEN=

# Необязательно: где хранить токены и состояние (по умолчанию ~/.config/crossfade)
# CROSSFADE_DATA_DIR=
